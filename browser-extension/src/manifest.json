{
  "manifest_version": 3,
  "name": "Claude Limits",
  "short_name": "Claude Limits",
  "version": "1.0.0",
  "description": "Claude Pro/Max kullanım limitlerini (oturum, haftalık, model bazlı) ve isteğe bağlı API limitlerini araç çubuğunda gösterir.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Claude Limits",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["alarms", "storage", "cookies", "notifications"],
  "host_permissions": ["https://claude.ai/*", "https://api.anthropic.com/*"],
  "minimum_chrome_version": "116"
}
