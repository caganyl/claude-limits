      <Project>{6AE586A2-DD20-45DA-8A8E-5E94FFC79DED}</Project>
      <Name>ClaudeLimits.Core</Name>
      <!-- Pack only ClaudeLimits.Core.dll into the .vsix (its Newtonsoft.Json dependency is provided by Visual Studio). -->
      <IncludeOutputGroupsInVSIX>BuiltProjectOutputGroup</IncludeOutputGroupsInVSIX>
      <IncludeOutputGroupsInVSIXLocalOnly>DebugSymbolsProjectOutputGroup</IncludeOutputGroupsInVSIXLocalOnly>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Visual Studio already loads Newtonsoft.Json 13.x (assembly version 13.0.0.0); never ship our own copy. -->
    <SuppressFromVsix Include="Newtonsoft.Json.dll" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != ''" />
  <!-- Belt and braces: drop Newtonsoft.Json from the VSIX payload even if SuppressFromVsix is not honoured. -->
  <Target Name="ClaudeLimitsExcludeNewtonsoftFromVsix" AfterTargets="GetVsixSourceItems">
    <ItemGroup>
      <VSIXSourceItem Remove="@(VSIXSourceItem)" Condition="'%(Filename)' == 'Newtonsoft.Json'" />
    </ItemGroup>
  </Target>
</Project>
