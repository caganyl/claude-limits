root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true

[*.{csproj,vsct,vsixmanifest,xaml,props,targets}]
indent_size = 2

[*.cs]
# Threading analyzers (Microsoft.VisualStudio.Threading.Analyzers) and VSSDK analyzers: warnings, never errors.
dotnet_diagnostic.VSTHRD001.severity = warning
dotnet_diagnostic.VSTHRD002.severity = warning
dotnet_diagnostic.VSTHRD003.severity = warning
dotnet_diagnostic.VSTHRD004.severity = warning
